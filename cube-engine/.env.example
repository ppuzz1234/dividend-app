# 복사해서 .env 로 만들고 값을 채운다:  cp .env.example .env
# .env 는 커밋되지 않는다. 이 파일만 커밋된다 — 키 값은 절대 채워 넣지 마라.

# ─────────────────────────────────────────────
# 답변 생성 LLM — ★ 여기가 답변 품질을 정한다
# ─────────────────────────────────────────────
# docs/ANSWER-QUALITY-*.md 의 측정치는 전부 **아래 조합**으로 잰 것이다.
# 다르게 채우면 다른 품질이 나온다. 그래서 provider·model 을 비워 두지 않고 못 박는다.
#
#     provider=claude · model=claude-sonnet-5 · effort=medium
#
# provider 를 비워 두면 코드가 "Claude 키가 있으면 claude, 없으면 gemini" 로 추측한다.
# 추측에 맡기면 키 하나 안 채웠을 때 **조용히 gemini-2.5-flash 로 떨어져** 다른 답이 나온다.
ANSWER_PROVIDER=claude
ANSWER_MODEL=claude-sonnet-5

# 답변 생성용 Anthropic 키. 비우면 아래 ATTACK_API_KEY 를 대신 쓴다.
ANSWER_API_KEY=

# 추론 강도 — low / medium / high / xhigh / max. **claude 전용**이다
# (gemini 인데 이 값이 있으면 엔진이 뜨지 않고 그 자리에서 알려준다).
# medium 인 이유: 실측에서 high 대비 품질이 유지되면서 넓은 질문이 30초 벽을 넘겼다
# (docs/ANSWER-QUALITY-WIDE-sonnet-5_e-*.md). 매니페스트에도 기록된다 —
# 같은 모델·같은 프롬프트라도 effort 가 다르면 다른 답이라 재현에 필요하다.
ANSWER_EFFORT=medium

# 정책 팩 초안을 공격·검증하는 쪽(Maker-Checker 의 Checker). 초안 생성과
# **다른 모델**을 쓰는 것이 요점이다 — 같은 모델이 자기 초안을 검토하면 검토가 아니다.
# ANSWER_API_KEY 를 비워 두면 이 키가 답변에도 쓰인다.
ATTACK_API_KEY=
ATTACK_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────
# 임베딩 (색인 생성) — Gemini
# ─────────────────────────────────────────────
# 답변 모델과 별개다. 조문을 벡터로 만드는 데 쓴다.
LLM_API_KEY=

# ★ 검증된 조합이다. 바꾸면 색인이 달라지고 **검색 순위가 조용히 바뀐다.**
# 이 값으로 만든 색인 기준 hit@1 22/26 · hit@5 25/26 (docs/MISSION2-SEAM.md §4).
# 색인에 embedModel·embedDim·corpusHash 가 박히므로 어긋나면 매니페스트에서 드러난다.
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=3072

# ─────────────────────────────────────────────
# 국가법령정보 공동활용 API (조문 원문 수집)
# ─────────────────────────────────────────────
# 이미 수집된 스냅샷이 packages/corpus/snapshots 에 있으므로, 조문을 새로 받을 때만 필요하다.
# OC = 신청 시 등록한 이메일의 @ 앞부분. 비밀키가 아니라 신청자 식별자다.
# 발급: https://open.law.go.kr
LAW_OC=

# ─────────────────────────────────────────────
# 교차 출처 (프런트에서 이 엔진을 부를 때)
# ─────────────────────────────────────────────
# 비워 두면 같은 PC 의 로컬 개발 서버(localhost·127.0.0.1, 포트 무관)를 허용한다.
# 다른 출처에서 부르려면 여기에 적는다(쉼표로 여러 개). 적는 순간 로컬 기본값은 꺼진다.
# 와일드카드 * 는 지원하지 않는다 — 이 엔진은 키를 쥐고 호출당 비용이 나간다.
CUBE_CORS_ORIGIN=
