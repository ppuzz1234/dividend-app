{
  "name": "@cube/corpus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "tsc -b tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "collect": "tsc -b tsconfig.json && node --env-file-if-exists=../../.env dist/scripts/collect.js",
    "measure:mok": "tsc -b tsconfig.json && node --env-file-if-exists=../../.env dist/scripts/measure-mok.js",
    "collect:admrul": "tsc -b tsconfig.json && node --env-file-if-exists=../../.env dist/scripts/collect-admrul.js",
    "scan:deadlines": "tsc -b tsconfig.json && node dist/scripts/scan-deadlines.js"
  },
  "dependencies": {
    "@cube/numeric": "*"
  }
}
