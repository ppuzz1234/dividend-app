# Supabase — supabase-js(HTTP) + RLS 방식 (실제 값은 .env.local 에만, 이 파일은 커밋됨)
# anon key 는 공개되어도 안전(RLS 가 본인 행만 허용). service_role 키는 절대 여기에 넣지 말 것.
VITE_SUPABASE_URL=https://[PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=[ANON-KEY]

# 구글 로그인 레이어 모달(One Tap/FedCM)용 — Google OAuth 웹 클라이언트 ID (선택)
# 설정 시 페이지 안 레이어로 인증, 미설정 시 팝업창 방식으로 동작.
# Supabase > Providers > Google 의 Client IDs 에도 같은 값을 등록해야 한다.
# VITE_GOOGLE_CLIENT_ID=[CLIENT-ID].apps.googleusercontent.com

# 피드 탭 유튜브 채널 영상 조회용 — YouTube Data API v3 키 (선택)
# Google Cloud Console 에서 YouTube Data API v3 활성화 후 API 키 발급,
# HTTP 리퍼러(localhost·운영 도메인)로 제한 권장. 미설정 시 피드 탭에 안내만 표시.
# VITE_YOUTUBE_API_KEY=[API-KEY]

# 백엔드 API 주소 오버라이드 (선택)
# VITE_API_BASE=http://localhost:4000
